<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Icon/Logo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/icon"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp" />

        <!-- Welcome Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/landing_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OWASP Security Shepherd Project"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textColor="#666666"
            android:layout_marginBottom="32dp" />

        <!-- Warning Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF3CD"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/landing_warning"
                android:textSize="14sp"
                android:textColor="#856404"
                android:textAlignment="center"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This application is designed for educational purposes as part of the OWASP Security Shepherd project."
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="#333333"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Continue Button -->
        <Button
            android:id="@+id/enter_app_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/landing_button"
            android:textSize="18sp"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <!-- License Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Licensed under GNU GPL v3"
            android:textSize="12sp"
            android:textAlignment="center"
            android:textColor="#999999"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
