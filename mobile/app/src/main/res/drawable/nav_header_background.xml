<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Black background for top portion -->
    <item>
        <color android:color="#000000" />
    </item>
    
    <!-- Grass tile at the bottom of the header -->
    <item 
        android:gravity="bottom"
        android:height="40dp">
        <bitmap
            android:src="@drawable/grass_tile_v2"
            android:tileMode="repeat"
            android:gravity="bottom" />
    </item>
    
    <!-- Shepherd and sheep image -->
    <item 
        android:gravity="center_horizontal|top"
        android:top="0dp">
        <bitmap
            android:src="@drawable/shepherd_and_sheep_v2"
            android:gravity="center_horizontal|top" />
    </item>
</layer-list>
