<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@color/card_warning_bg"
            app:strokeColor="#FFC107"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find security misconfigurations in AndroidManifest.xml. Decompile the APK and check for debuggable=true, allowBackup=true, and exported components."
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Interactive Demo Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/demo_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#FFC107"
            app:strokeWidth="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuration Check Exercise"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This exercise shows various security configuration settings. Check which ones are properly configured and which are security risks!"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginBottom="16dp" />

                <!-- Configuration Status Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/background_primary"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/debug_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Debug Mode: Checking..."
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/backup_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Backup Allowed: Checking..."
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/exported_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Exported Components: Checking..."
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/network_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Network Security: Checking..."
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/permissions_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Permissions: Checking..."
                        android:textSize="14sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <Button
                    android:id="@+id/check_config_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check Configuration"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/result_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
